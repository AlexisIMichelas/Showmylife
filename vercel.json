{
    "version": 2,
    "builds": [
      {
        "src": "public/index.php",
        "use": "@vercel/php"
      }
    ],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "/public/index.php"
      }
    ],
    "env": {
      "APP_ENV": "prod",
      "APP_SECRET": "@app_secret",
      "DATABASE_URL": "@database_url",
      "MAILER_DSN": "@mailer_dsn",
      "MESSENGER_TRANSPORT_DSN": "@messenger_transport_dsn"
    }
  }
  